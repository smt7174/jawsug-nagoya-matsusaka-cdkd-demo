{
  "name": "jawsug-nagoya-matsusaka-cdkd-demo",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "cdk": "cdk",
    "deploy:cfn": "scripts/bench.sh cfn deploy",
    "destroy:cfn": "scripts/bench.sh cfn destroy",
    "deploy:cdkd": "scripts/bench.sh cdkd deploy",
    "deploy:cdkd:nowait": "EXTRA=--no-wait scripts/bench.sh cdkd deploy",
    "destroy:cdkd": "scripts/bench.sh cdkd destroy"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@cdkd/cli": "^0.334.3",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1148.0",
    "esbuild": "^0.28.2",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.5.0"
  }
}
